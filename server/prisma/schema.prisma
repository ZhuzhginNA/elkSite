generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id               String    @id @default(cuid())
  slug             String    @unique
  draftContent     Json
  publishedContent Json
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?
}

model HomeContent {
  id               String    @id @default("home")
  draftContent     Json
  publishedContent Json
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?
}

model BlogPost {
  id               String        @id @default(cuid())
  slug             String        @unique
  draftContent     Json
  publishedContent Json?
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
}

model GalleryImage {
  id               String        @id @default(cuid())
  draftContent     Json
  publishedContent Json?
  sortOrder        Int           @default(0)
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
}

model DocumentItem {
  id               String        @id @default(cuid())
  draftContent     Json
  publishedContent Json?
  sortOrder        Int           @default(0)
  status           ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  publishedAt      DateTime?
}

model ContactInfo {
  id               String    @id @default("contacts")
  draftContent     Json
  publishedContent Json
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?
}

model CatalogSettings {
  id               String    @id @default("catalog")
  draftContent     Json
  publishedContent Json
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())
}
